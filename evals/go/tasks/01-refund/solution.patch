+// Refund adds amt back to the balance. It panics when amt is not positive.
+func Refund(acc Account, amt Money) Account {
+	if amt <= 0 {
+		panic("billing.Refund: amt must be positive")
+	}
+	acc.Balance += amt
+	return acc
+}
