+/// Adds amt back to the balance.
+pub fn refund(acc: Account, amt: Money) -> Account
+  pre  amt.0 > 0
+  post ret.balance.0 == acc.balance.0 + amt.0
+{
+  Account { ..acc, balance: Money(acc.balance.0 + amt.0) }
+}
+
 /// Generator for `any Money via positive_money`: draws through `g` so failures shrink.
 pub fn positive_money(g: Gen) -> Money { Money(g.int(1, 1_000_000)) }
 
