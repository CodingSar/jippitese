module prelude

/// Immutable sequence.
pub extern type List<T> = go "rt".List
/// `a..b` (exclusive) or `a..=b` (inclusive) over `Int`.
pub extern type Range<T> = go "rt".Range
/// Immutable map.
pub extern type Map<K, V> = go "rt".Map
/// Immutable set.
pub extern type Set<T> = go "rt".Set
/// Mutable sequence; every operation is `mut`.
pub extern type MutList<T> = go "rt".MutList
/// Mutable map; every operation is `mut`.
pub extern type MutMap<K, V> = go "rt".MutMap
/// Mutable set; every operation is `mut`.
pub extern type MutSet<T> = go "rt".MutSet
/// Shared mutable slot; reading or writing is `mut`.
pub extern type Cell<T> = go "rt".Cell
/// Handle of a task started with `task` inside `spawn`.
pub extern type Task<T> = go "rt".Task
/// A topic declared in `app.jip`.
pub extern type Topic<T> = go "rt".Topic
/// Source of random choices for `via` generators.
pub extern type Gen = go "rt".Gen
/// File-system path.
pub extern type Path = go "rt".Path
/// Schema-less JSON value.
pub extern type Json = go "rt".Json
/// Identifier of a workflow run.
pub extern type RunId = go "rt".RunId
/// Repository query.
pub extern type Query<T> = go "rt".Query
/// A function an `Agent` may call, built with `tools [f, g]`.
pub extern type Tool = go "rt".Tool

/// A URL.
pub type Url(Str)
/// The text of a Go `error`.
pub type GoError(Str)
/// Calibrated confidence in [0, 1].
pub type Score(Float)
/// A value with the confidence the model assigned to it.
pub type Calibrated<T> { value: T, confidence: Float }
/// A contract that fired inside a behaviour method.
pub type ContractViolation { kind: Str, expr: Str, at: Str }
/// Retry policy of a `Worker`.
pub type Retry { max: Int, backoff: Backoff }
/// What a human reviewer sees for an `approve`.
pub type Review { title: Str, body: Str, timeout: Option<Duration>, data: Option<Json> }
/// Why an approval did not return a value.
pub type Rejected { reason: Option<Str>, timed_out: Bool }
/// A reviewer's answer from an approval channel's `ask`: `Approve` carries the decision value as JSON, decoded as the `approve` call's `T`; `Reject` an optional reason.
pub enum ReviewAnswer { Approve(Json), Reject(Option<Str>) }
/// A journal that does not match the code replaying it.
pub type ReplayError { expected: Int, found: Int }
/// Liveness and readiness of a running impl.
pub type Health { live: Bool, ready: Bool, detail: Option<Str> }
/// A model role from `models {}` in `app.jip`.
pub type Role(Str)
/// Money in minor units.
pub type Money(Int)
/// Limits of one `Agent` run; both are required.
pub type Budget { max_turns: Int, max_cost: Money }
/// A tool call the model asked for: which tool, and its arguments.
pub type ToolCall<T> { tool: T, args: Json }

/// An optional value.
pub enum Option<T> { None, Some(T) }
/// Success or failure.
pub enum Result<T, E> { Ok(T), Err(E) }
/// When a `Cron` fires.
pub enum Schedule { Every(Duration), Cron(Str) }
/// Delay between retries.
pub enum Backoff { Fixed(Duration), Exp(Duration) }
/// `Repository` failures.
pub enum RepoError { NotFound, Conflict, Unavailable(Str), Invalid(Str) }
/// `Cache` failures.
pub enum CacheError { Unavailable(Str) }
/// Topic failures.
pub enum TopicError { Unavailable(Str) }
/// Queue failures.
pub enum QueueError { Full, Unavailable(Str) }
/// `Machine.send` failures.
pub enum MachineError { Full, Unavailable(Str) }
/// `llm` failures.
pub enum LlmError { Schema(Str), Refused(Str), Transport(Str), Budget }
/// What a workflow run can fail with.
pub enum WorkflowError<E> { Replay(ReplayError), Approval(Rejected), Cancelled, App(E) }
/// File-system failures.
pub enum IoError { NotFound(Str), Permission(Str), Other(Str) }
/// Network failures.
pub enum NetError { Timeout, Refused(Str), Other(Str) }
/// What happened in one step of an `Agent` loop.
pub enum Event<T> { Said(Str), Called(ToolCall<T>), Returned(ToolCall<T>, Str), Compacted }
/// Whether an `Agent` may run a tool call.
pub enum Gate { Allow, Deny(Str), Ask }
/// The limit an `Agent` run hit.
pub enum BudgetExceeded { Turns, Cost }
/// How an `Agent` run ended.
pub enum Outcome<A> { Finished(A), Stopped(BudgetExceeded), Refused(Str) }
/// `Agent.init` failures.
pub enum AgentError { Unavailable(Str), Invalid(Str) }

impl Health {
  /// Live and ready.
  pub extern fn up() -> Health = go "rt".HealthUp
  /// Health of an impl from its references; v0 reports up.
  pub extern fn aggregate<T>(x: T) -> Health = go "rt".HealthAggregate
}

/// A float in [0, 1).
pub extern fn random() -> Float with {nondet} = go "rt".Random
/// Waits for the next signal of a running workflow.
pub extern fn await_signal<S>(timeout: Duration) -> Option<S> with {nondet} = go "rt".AwaitSignal
/// Panics with `msg`; the type unifies with anything.
pub extern fn panic<T>(msg: Str) -> T = go "rt".Panic

/// Serves requests.
pub behaviour Service {
  type Req
  type Resp
  type E
  fn init(cfg: Config) -> Result<Self, E> with {io, net, mut}
  fn handle(self, req: Req) -> Result<Resp, E> with {io, net, mut, llm, decide, nondet, spawn}
  fn stop(self) with {io, net} {}
  fn health(self) -> Health with {io, net} { Health.aggregate(self) }
}

/// Consumes messages.
pub behaviour Worker {
  type Msg
  type E
  const retry: Retry
  fn init(cfg: Config) -> Result<Self, E> with {io, net, mut}
  fn perform(self, m: Msg) -> Result<(), E> with {io, net, mut, llm, decide, nondet}
  fn stop(self) with {io, net} {}
  fn health(self) -> Health with {io, net} { Health.aggregate(self) }
}

/// Runs on a schedule.
pub behaviour Cron {
  type E
  const schedule: Schedule
  fn init(cfg: Config) -> Result<Self, E> with {io, net, mut}
  fn run(self) -> Result<(), E> with {io, net, mut, llm, decide, nondet}
  fn stop(self) with {io, net} {}
  fn health(self) -> Health with {io, net} { Health.aggregate(self) }
}

/// A keyed state machine: one turn per key at a time.
pub behaviour Machine {
  type Key
  type State
  type Event
  type Action
  type E
  fn init(cfg: Config) -> Result<Self, E> with {io, net, mut}
  fn activate(self, key: Key) -> State
  fn on(self, s: State, e: Event) -> (State, List<Action>)
  fn act(self, key: Key, a: Action) -> Result<List<Event>, E> with {io, net, llm, decide, nondet}
  fn deactivate(self, key: Key, s: State) with {io, net} {}
  fn stop(self) with {io, net} {}
  fn health(self) -> Health with {io, net} { Health.aggregate(self) }
}

/// A durable, replayable run.
pub behaviour Workflow {
  type Input
  type Output
  type Signal
  type E
  const version: Int
  fn init(cfg: Config) -> Result<Self, E> with {io, net, mut}
  fn run(self, input: Input) -> Result<Output, WorkflowError<E>> with {io, net, llm, decide, nondet, spawn, approve}
  fn on_signal(self, s: Signal) {}
}

/// A bounded model loop over tools; `Tools` is generated from `tools`.
pub behaviour Agent {
  type State
  type Answer
  type Tools
  const model: Role
  const tools: List<Tool>
  const budget: Budget
  fn init(cfg: Config) -> Result<Self, AgentError> with {io, net, mut}
  fn begin(self, goal: Str) -> State
  fn observe(self, st: State, ev: Event<Tools>) -> State
  fn stop(self, st: State) -> Option<Answer>
  fn gate(self, call: ToolCall<Tools>) -> Gate with {decide, approve} { Gate.Allow }
}

/// Keyed storage.
pub behaviour Repository<T, K> {
  fn init(cfg: Config) -> Result<Self, RepoError> with {io, net, mut}
  fn get(self, k: K) -> Result<Option<T>, RepoError> with {io, net, mut}
  fn put(self, k: K, v: T) -> Result<(), RepoError> with {io, net, mut}
  fn delete(self, k: K) -> Result<(), RepoError> with {io, net, mut}
  fn query(self, q: Query<T>) -> Result<List<T>, RepoError> with {io, net, mut}
  fn stop(self) with {io, net} {}
  fn health(self) -> Health with {io, net} { Health.up() }
}

/// Keyed storage that may forget.
pub behaviour Cache<K, V> {
  fn init(cfg: Config) -> Result<Self, CacheError> with {io, net, mut}
  fn get(self, k: K) -> Result<Option<V>, CacheError> with {io, net, mut, nondet}
  fn set(self, k: K, v: V, ttl: Option<Duration>) -> Result<(), CacheError> with {io, net, mut, nondet}
  fn invalidate(self, k: K) -> Result<(), CacheError> with {io, net, mut, nondet}
  fn stop(self) with {io, net} {}
  fn health(self) -> Health with {io, net} { Health.up() }
}

impl Str {
  /// Number of characters.
  pub extern fn len(self) -> Int = go "rt".StrLen
  /// True when empty.
  pub extern fn is_empty(self) -> Bool = go "rt".StrIsEmpty
  /// Substring test.
  pub extern fn contains(self, s: Str) -> Bool = go "rt".StrContains
  /// Prefix test.
  pub extern fn starts_with(self, s: Str) -> Bool = go "rt".StrStartsWith
  /// Suffix test.
  pub extern fn ends_with(self, s: Str) -> Bool = go "rt".StrEndsWith
  /// Upper case.
  pub extern fn to_upper(self) -> Str = go "rt".StrToUpper
  /// Lower case.
  pub extern fn to_lower(self) -> Str = go "rt".StrToLower
  /// Without surrounding whitespace.
  pub extern fn trim(self) -> Str = go "rt".StrTrim
  /// Split on a separator.
  pub extern fn split(self, sep: Str) -> List<Str> = go "rt".StrSplit
  /// UTF-8 bytes.
  pub extern fn bytes(self) -> Bytes = go "rt".StrBytes
  /// Parse a decimal integer.
  pub extern fn parse_int(self) -> Option<Int> = go "rt".StrParseInt
  /// Characters.
  pub extern fn chars(self) -> List<Char> = go "rt".StrChars
  /// Parse a decimal float; NaN and infinities are `None`.
  pub extern fn parse_float(self) -> Option<Float> = go "rt".StrParseFloat
  /// Every `from` replaced by `to`.
  pub extern fn replace(self, from: Str, to: Str) -> Str = go "rt".StrReplace
  /// Character index of the first `s`.
  pub extern fn index_of(self, s: Str) -> Option<Int> = go "rt".StrIndexOf
  /// Characters `from` up to `to`, both clamped to the string.
  pub extern fn slice(self, from: Int, to: Int) -> Str = go "rt".StrSlice
  /// Without leading whitespace.
  pub extern fn trim_start(self) -> Str = go "rt".StrTrimStart
  /// Without trailing whitespace.
  pub extern fn trim_end(self) -> Str = go "rt".StrTrimEnd
  /// The rest after prefix `p`, if present.
  pub extern fn strip_prefix(self, p: Str) -> Option<Str> = go "rt".StrStripPrefix
  /// The rest before suffix `p`, if present.
  pub extern fn strip_suffix(self, p: Str) -> Option<Str> = go "rt".StrStripSuffix
  /// `n` copies; traps when `n` is negative.
  pub extern fn repeat(self, n: Int) -> Str = go "rt".StrRepeat
  /// Padded on the left with `c` to `width` characters.
  pub extern fn pad_left(self, width: Int, c: Char) -> Str = go "rt".StrPadLeft
  /// Padded on the right with `c` to `width` characters.
  pub extern fn pad_right(self, width: Int, c: Char) -> Str = go "rt".StrPadRight
  /// Lines, without `\n` or `\r\n`; a final newline adds no empty line.
  pub extern fn lines(self) -> List<Str> = go "rt".StrLines
}

impl Int {
  /// Decimal text.
  pub extern fn to_str(self) -> Str = go "rt".IntToStr
  /// Absolute value.
  pub extern fn abs(self) -> Int = go "rt".IntAbs
  /// As a float.
  pub extern fn to_float(self) -> Float = go "rt".IntToFloat
  /// Smaller of two.
  pub extern fn min(self, o: Int) -> Int = go "rt".IntMin
  /// Larger of two.
  pub extern fn max(self, o: Int) -> Int = go "rt".IntMax
  /// Limited to `lo..=hi`; traps when `lo > hi`.
  pub extern fn clamp(self, lo: Int, hi: Int) -> Int = go "rt".IntClamp
  /// Sum, `None` on overflow.
  pub extern fn checked_add(self, o: Int) -> Option<Int> = go "rt".IntCheckedAdd
  /// Difference, `None` on overflow.
  pub extern fn checked_sub(self, o: Int) -> Option<Int> = go "rt".IntCheckedSub
  /// Product, `None` on overflow.
  pub extern fn checked_mul(self, o: Int) -> Option<Int> = go "rt".IntCheckedMul
  /// Sum, wrapping on overflow.
  pub extern fn wrapping_add(self, o: Int) -> Int = go "rt".IntWrappingAdd
  /// Difference, wrapping on overflow.
  pub extern fn wrapping_sub(self, o: Int) -> Int = go "rt".IntWrappingSub
  /// Product, wrapping on overflow.
  pub extern fn wrapping_mul(self, o: Int) -> Int = go "rt".IntWrappingMul
  /// `self` to the power `e`; traps on a negative `e` or overflow.
  pub extern fn pow(self, e: Int) -> Int = go "rt".IntPow
}

impl Float {
  /// Shortest text that round-trips.
  pub extern fn to_str(self) -> Str = go "rt".FloatToStr
  /// Fixed-point text with `decimals` digits after the point.
  pub extern fn format(self, decimals: Int) -> Str = go "rt".FloatFormat
  /// Largest integer not above; this and the other conversions to Int trap
  /// on NaN, infinities and values outside Int.
  pub extern fn floor(self) -> Int = go "rt".FloatFloor
  /// Smallest integer not below.
  pub extern fn ceil(self) -> Int = go "rt".FloatCeil
  /// Nearest integer, halves away from zero.
  pub extern fn round(self) -> Int = go "rt".FloatRound
  /// Integer part, towards zero.
  pub extern fn to_int(self) -> Int = go "rt".FloatToInt
  /// Absolute value.
  pub extern fn abs(self) -> Float = go "rt".FloatAbs
  /// Not a number.
  pub extern fn is_nan(self) -> Bool = go "rt".FloatIsNan
  /// Smaller of two.
  pub extern fn min(self, o: Float) -> Float = go "rt".FloatMin
  /// Larger of two.
  pub extern fn max(self, o: Float) -> Float = go "rt".FloatMax
  /// Limited to `lo..=hi`; traps when `lo > hi`.
  pub extern fn clamp(self, lo: Float, hi: Float) -> Float = go "rt".FloatClamp
}

impl Bytes {
  /// Number of bytes.
  pub extern fn len(self) -> Int = go "rt".BytesLen
  /// As text; invalid UTF-8 is replaced.
  pub extern fn to_str(self) -> Str = go "rt".BytesToStr
  /// Concatenation.
  pub extern fn concat(self, o: Bytes) -> Bytes = go "rt".BytesConcat
}

impl Json {
  /// Field `key` of an object; the last duplicate wins.
