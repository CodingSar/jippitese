  /// Element `i` of an array.
  pub extern fn at(self, i: Int) -> Option<Json> = go "rt".JsonAt
  /// The text of a string.
  pub extern fn as_str(self) -> Option<Str> = go "rt".JsonAsStr
  /// An integral number within Int range; `2.0` counts.
  pub extern fn as_int(self) -> Option<Int> = go "rt".JsonAsInt
  /// A number that fits a Float.
  pub extern fn as_float(self) -> Option<Float> = go "rt".JsonAsFloat
  /// A boolean.
  pub extern fn as_bool(self) -> Option<Bool> = go "rt".JsonAsBool
  /// Null test.
  pub extern fn is_null(self) -> Bool = go "rt".JsonIsNull
  /// The elements of an array.
  pub extern fn as_list(self) -> Option<List<Json>> = go "rt".JsonAsList
  /// The fields of an object in source order.
  pub extern fn as_map(self) -> Option<Map<Str, Json>> = go "rt".JsonAsMap
  /// The field names of an object in source order.
  pub extern fn keys(self) -> Option<List<Str>> = go "rt".JsonKeys
  /// Compact text.
  pub extern fn to_str(self) -> Str = go "rt".JsonToStr
  /// Compact encoding.
  pub extern fn to_bytes(self) -> Bytes = go "rt".JsonToBytes
}

impl Path {
  /// The path `s`, cleaned: `a/./b/` is `a/b`.
  pub extern fn of(s: Str) -> Path = go "rt".PathOf
  /// `self` with the element `name` appended.
  pub extern fn join(self, name: Str) -> Path = go "rt".PathJoin
  /// The path as text.
  pub extern fn to_str(self) -> Str = go "rt".PathToStr
  /// The last element.
  pub extern fn name(self) -> Str = go "rt".PathName
  /// All but the last element.
  pub extern fn parent(self) -> Path = go "rt".PathParent
}

impl Duration {
  /// Whole seconds.
  pub extern fn seconds(self) -> Int = go "rt".DurationSeconds
  /// Whole milliseconds.
  pub extern fn millis(self) -> Int = go "rt".DurationMillis
  /// Whole minutes.
  pub extern fn minutes(self) -> Int = go "rt".DurationMinutes
  /// Whole hours.
  pub extern fn hours(self) -> Int = go "rt".DurationHours
  /// Text such as `1h2m3.5s`.
  pub extern fn to_str(self) -> Str = go "rt".DurationToStr
  /// `n` milliseconds; traps on overflow.
  pub extern fn of_millis(n: Int) -> Duration = go "rt".DurationOfMillis
  /// `n` seconds; traps on overflow.
  pub extern fn of_seconds(n: Int) -> Duration = go "rt".DurationOfSeconds
  /// `n` times `self`; traps on overflow.
  pub extern fn times(self, n: Int) -> Duration = go "rt".DurationTimes
}

impl Range<T> {
  /// Membership; `(lo..hi).contains(x)` lowers to `lo <= x && x < hi`.
  pub extern fn contains(self, x: T) -> Bool = go "rt".ListContains
}

impl List<T> {
  /// Number of elements.
  pub extern fn len(self) -> Int = go "rt".ListLen
  /// True when empty.
  pub extern fn is_empty(self) -> Bool = go "rt".ListIsEmpty
  /// Element at `i`.
  pub extern fn get(self, i: Int) -> Option<T> = go "rt".ListGet
  /// First element.
  pub extern fn first(self) -> Option<T> = go "rt".ListFirst
  /// Last element.
  pub extern fn last(self) -> Option<T> = go "rt".ListLast
  /// Apply `f` to every element.
  pub extern fn map<U>(self, f: fn(T) -> U) -> List<U> = go "rt".ListMap
  /// Keep the elements `f` accepts.
  pub extern fn filter(self, f: fn(T) -> Bool) -> List<T> = go "rt".ListFilter
  /// Left fold.
  pub extern fn fold<A>(self, init: A, f: fn(A, T) -> A) -> A = go "rt".ListFold
  /// Run `f` on every element.
  pub extern fn each(self, f: fn(T)) = go "rt".ListEach
  /// First element `f` accepts.
  pub extern fn find(self, f: fn(T) -> Bool) -> Option<T> = go "rt".ListFind
  /// True when `f` accepts any element.
  pub extern fn some(self, f: fn(T) -> Bool) -> Bool = go "rt".ListSome
  /// True when `f` accepts every element.
  pub extern fn all(self, f: fn(T) -> Bool) -> Bool = go "rt".ListAll
  /// Membership.
  pub extern fn contains(self, x: T) -> Bool = go "rt".ListContains
  /// With `x` appended.
  pub extern fn push(self, x: T) -> List<T> = go "rt".ListPush
  /// Both lists.
  pub extern fn concat(self, o: List<T>) -> List<T> = go "rt".ListConcat
  /// Reversed.
  pub extern fn reverse(self) -> List<T> = go "rt".ListReverse
  /// First `n`.
  pub extern fn take(self, n: Int) -> List<T> = go "rt".ListTake
  /// Without the first `n`.
  pub extern fn drop(self, n: Int) -> List<T> = go "rt".ListDrop
  /// Sorted by key.
  pub extern fn sort_by<K: Ord>(self, key: fn(T) -> K) -> List<T> = go "rt".ListSortBy
  /// Mutable copy.
  pub extern fn thaw(self) -> MutList<T> with {mut} = go "rt".ListThaw
}

