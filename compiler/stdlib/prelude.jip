impl Option<T> {
  /// True for `Some`.
  pub extern fn is_some(self) -> Bool = go "rt".OptionIsSome
  /// True for `None`.
  pub extern fn is_none(self) -> Bool = go "rt".OptionIsNone
  /// The value, or `d`.
  pub extern fn unwrap_or(self, d: T) -> T = go "rt".OptionUnwrapOr
  /// The value; panics on `None`.
  pub extern fn unwrap(self) -> T = go "rt".OptionUnwrap
  /// Apply `f` to the value.
  pub extern fn map<U>(self, f: fn(T) -> U) -> Option<U> = go "rt".OptionMap
  /// Chain.
  pub extern fn and_then<U>(self, f: fn(T) -> Option<U>) -> Option<U> = go "rt".OptionAndThen
  /// `Ok` of the value, or `Err(e)`.
  pub extern fn ok_or<E>(self, e: E) -> Result<T, E> = go "rt".OptionOkOr
}

impl Result<T, E> {
  /// True for `Ok`.
  pub extern fn is_ok(self) -> Bool = go "rt".ResultIsOk
  /// True for `Err`.
  pub extern fn is_err(self) -> Bool = go "rt".ResultIsErr
  /// The value, or `d`.
  pub extern fn unwrap_or(self, d: T) -> T = go "rt".ResultUnwrapOr
  /// The value; panics on `Err`.
  pub extern fn unwrap(self) -> T = go "rt".ResultUnwrap
  /// Apply `f` to the value.
  pub extern fn map<U>(self, f: fn(T) -> U) -> Result<U, E> = go "rt".ResultMap
  /// Apply `f` to the error.
  pub extern fn map_err<F>(self, f: fn(E) -> F) -> Result<T, F> = go "rt".ResultMapErr
  /// Chain.
  pub extern fn and_then<U>(self, f: fn(T) -> Result<U, E>) -> Result<U, E> = go "rt".ResultAndThen
  /// `Some` of the value.
  pub extern fn ok(self) -> Option<T> = go "rt".ResultOk
  /// `Some` of the error.
  pub extern fn err(self) -> Option<E> = go "rt".ResultErr
}

impl Gen {
  /// Integer in [lo, hi].
  pub extern fn int(self, lo: Int, hi: Int) -> Int = go "rt".GenInt
  /// Float in [lo, hi).
  pub extern fn float(self, lo: Float, hi: Float) -> Float = go "rt".GenFloat
  /// Coin flip.
  pub extern fn bool(self) -> Bool = go "rt".GenBool
  /// Text of at most `max_len` characters.
  pub extern fn str(self, max_len: Int) -> Str = go "rt".GenStr
  /// One of `xs`.
  pub extern fn pick<T>(self, xs: List<T>) -> T = go "rt".GenPick
}
