module std.math

/// Square root; NaN below zero.
pub extern fn sqrt(x: Float) -> Float = go "rt".MathSqrt
/// `b` to the power `e`.
pub extern fn pow(b: Float, e: Float) -> Float = go "rt".MathPow
/// e to the power `x`.
pub extern fn exp(x: Float) -> Float = go "rt".MathExp
/// Natural logarithm; NaN below zero, negative infinity at zero.
pub extern fn ln(x: Float) -> Float = go "rt".MathLn
/// Base-10 logarithm.
pub extern fn log10(x: Float) -> Float = go "rt".MathLog10
/// Base-2 logarithm.
pub extern fn log2(x: Float) -> Float = go "rt".MathLog2
/// Sine of `x` radians.
pub extern fn sin(x: Float) -> Float = go "rt".MathSin
/// Cosine of `x` radians.
pub extern fn cos(x: Float) -> Float = go "rt".MathCos
/// Tangent of `x` radians.
pub extern fn tan(x: Float) -> Float = go "rt".MathTan
/// Arc sine, in radians.
pub extern fn asin(x: Float) -> Float = go "rt".MathAsin
/// Arc cosine, in radians.
pub extern fn acos(x: Float) -> Float = go "rt".MathAcos
/// Arc tangent, in radians.
pub extern fn atan(x: Float) -> Float = go "rt".MathAtan
/// Angle of the point (`x`, `y`), in radians.
pub extern fn atan2(y: Float, x: Float) -> Float = go "rt".MathAtan2
/// Length of the vector (`x`, `y`) without overflow.
pub extern fn hypot(x: Float, y: Float) -> Float = go "rt".MathHypot
/// π.
pub extern fn pi() -> Float = go "rt".MathPi
/// Euler's number.
pub extern fn e() -> Float = go "rt".MathE
