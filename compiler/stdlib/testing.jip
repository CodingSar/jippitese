module std.testing

/// A request a `FakeHttp` recorded.
pub type Request { url: Url, body: Bytes }
/// One scripted `Agent` model turn: say text, call a tool with JSON
/// arguments, or refuse.
pub enum Reply { Say(Str), Call(Str, Str), Refuse(Str) }
/// Fake for `net`.
pub extern type FakeHttp = go "rt".FakeHttp
/// In-memory file system for `std.fs`.
pub extern type FakeFs = go "rt".FakeFs
/// Fake clock for `nondet`.
pub extern type FakeClock = go "rt".FakeClock
/// Fake random generator for `nondet`.
pub extern type FakeRandom = go "rt".FakeRandom
/// Scripted `llm` replies.
pub extern type FakeLlm = go "rt".FakeLlm
/// Scripted `decide` answers.
pub extern type FakeDecide = go "rt".FakeDecide
/// Scripted `approve` answers.
pub extern type FakeApprove = go "rt".FakeApprove
/// In-memory `Repository`.
pub extern type MemRepo<T, K> = go "rt".MemRepo
/// In-memory `Cache`.
pub extern type MemCache<K, V> = go "rt".MemCache

/// A recorded workflow history: what `record_workflow` returns and
/// `replay_workflow` runs against.
pub extern type Journal = go "rt".Journal

impl Journal {
  /// Number of recorded entries (steps and approvals).
  pub extern fn len(self) -> Int = go "rt".JournalLen
}

impl FakeHttp {
  /// A fake with no replies.
  pub extern fn new() -> FakeHttp = go "rt".FakeHttpNew
  /// Append a reply.
  pub extern fn reply(self, status: Int, body: Bytes) -> FakeHttp = go "rt".FakeHttpReply
  /// Every request seen so far.
  pub extern fn requests(self) -> List<Request> = go "rt".FakeHttpRequests
}

impl FakeFs {
  /// An empty file system.
  pub extern fn new() -> FakeFs = go "rt".FakeFsNew
  /// Add a file at `p` holding `b`, with its parent directories.
  pub extern fn file(self, p: Path, b: Bytes) -> FakeFs = go "rt".FakeFsFile
  /// Contents of the file at `p`, if there is one.
  pub extern fn contents(self, p: Path) -> Option<Bytes> = go "rt".FakeFsContents
}

impl FakeClock {
  /// A clock at the fixed test epoch.
  pub extern fn new() -> FakeClock = go "rt".FakeClockNew
  /// Advance by `d`.
  pub extern fn advance(self, d: Duration) = go "rt".FakeClockAdvance
}

impl FakeRandom {
  /// A generator seeded with `n`.
  pub extern fn seeded(n: Int) -> FakeRandom = go "rt".FakeRandomSeeded
}

impl FakeLlm {
  /// Reply `v` to every call of `role`.
  pub extern fn constant<T>(role: Str, v: T) -> FakeLlm = go "rt".FakeLlmConstant
  /// Answer the `Agent` turns of `role` in order; the last reply sticks.
  pub extern fn turns(role: Str, rs: List<Reply>) -> FakeLlm = go "rt".FakeLlmTurns
  /// Number of calls seen.
  pub extern fn calls(self) -> Int = go "rt".FakeLlmCalls
}

impl FakeDecide {
  /// Always answer `v`.
  pub extern fn always<T>(v: T) -> FakeDecide = go "rt".FakeDecideAlways
  /// Answer `vs` in order.
  pub extern fn script<T>(vs: List<T>) -> FakeDecide = go "rt".FakeDecideScript
}

impl FakeApprove {
  /// Answer in order; `Err(Rejected)` rejects.
  pub extern fn script<T>(answers: List<Result<T, Rejected>>) -> FakeApprove = go "rt".FakeApproveScript
  /// Every review asked so far.
  pub extern fn asked(self) -> List<Review> = go "rt".FakeApproveAsked
}

impl MemRepo<T, K> {
  /// An empty repository.
  pub extern fn new() -> MemRepo<T, K> = go "rt".MemRepoNew
  /// Value at `k`.
  pub extern fn get(self, k: K) -> Result<Option<T>, RepoError> with {mut} = go "rt".MemRepoGet
  /// Store `v` at `k`.
  pub extern fn put(self, k: K, v: T) -> Result<(), RepoError> with {mut} = go "rt".MemRepoPut
  /// Remove `k`.
  pub extern fn delete(self, k: K) -> Result<(), RepoError> with {mut} = go "rt".MemRepoDelete
}

impl MemCache<K, V> {
  /// An empty cache with the given default ttl.
  pub extern fn new(ttl: Duration) -> MemCache<K, V> = go "rt".MemCacheNew
  /// Value at `k`, unless expired under the installed clock.
  pub extern fn get(self, k: K) -> Result<Option<V>, CacheError> with {mut, nondet} = go "rt".MemCacheGet
  /// Store `v` at `k`.
  pub extern fn set(self, k: K, v: V, ttl: Option<Duration>) -> Result<(), CacheError> with {mut, nondet} = go "rt".MemCacheSet
  /// Forget `k`.
  pub extern fn invalidate(self, k: K) -> Result<(), CacheError> with {mut, nondet} = go "rt".MemCacheInvalidate
}

/// A fresh path under the scenario's temporary directory.
pub extern fn tmp_path(name: Str) -> Path with {io} = go "rt".TmpPath
/// Write `b` to `p`.
pub extern fn write_file(p: Path, b: Bytes) -> Result<(), IoError> with {io} = go "rt".WriteFile
